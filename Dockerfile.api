# Immagine dell'API di Cerbero (e, dalla Fase 2, del lavoratore dei calcoli).
# Node 22 LTS su Debian bookworm: python3 resta 3.11, come la CI (test-python).
FROM node:22-bookworm-slim

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Python per OR-Tools; tini come PID 1: inoltra i segnali (durante le
# migrazioni docker/avvio.sh li passa al migratore, poi l'API è il figlio
# diretto di tini) e raccoglie i processi figli (i solver)
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip tini \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── 1) Dipendenze Python (OR-Tools) ────────────────────────────────
# Layer cache: si invalida solo se cambia requirements.txt.
COPY requirements.txt ./
RUN python3 -m pip install --break-system-packages --target=/app/.python_packages -r requirements.txt \
 && python3 -c "import sys; sys.path.insert(0, '/app/.python_packages'); from ortools.sat.python import cp_model; print('ortools OK')"

# ── 2) Dipendenze JS nello store pnpm ──────────────────────────────
# `pnpm fetch` scarica le dipendenze del lockfile nello store senza i sorgenti:
# il layer si invalida SOLO quando cambiano lockfile/workspace (non ad ogni commit).
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

# ── 3) Sorgenti + install offline + build backend ──────────────────
COPY . .
RUN pnpm install --frozen-lockfile --prefer-offline \
 && pnpm run typecheck:libs \
 && pnpm --filter @workspace/api-server run build

# ── 4) Esecuzione come utente senza privilegi ──────────────────────
# L'API scrive solo in .cache (cache delle risposte, stato dei lavori) e in
# /tmp; i sorgenti restano di root, in sola lettura per il processo.
RUN mkdir -p /app/.cache && chown node:node /app/.cache
USER node

ENV NODE_ENV=production
ENV PORT=3000
ENV PYTHONPATH=/app/.python_packages:/app/scripts
# niente __pycache__ in /app/scripts, che non è scrivibile
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 3000
# Coolify usa questo HEALTHCHECK se il suo healthcheck dell'Application è
# spento (DEPLOY.md), e aspetta tutto lo start-period prima di controllare
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 CMD ["node", "docker/salute.mjs"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "docker/avvio.sh"]
