FROM node:20-slim

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Install Python for OR-Tools
RUN apt-get update && apt-get install -y python3 python3-pip && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── 1) Dipendenze Python (OR-Tools) ────────────────────────────────
# Layer cache: si invalida solo se cambia requirements.txt.
COPY requirements.txt ./
RUN python3 -m pip install --break-system-packages --target=/app/.python_packages -r requirements.txt \
 && python3 -c "import sys; sys.path.insert(0, '/app/.python_packages'); from ortools.sat.python import cp_model; print('ortools OK')"

# ── 2) Dipendenze JS nello store pnpm ──────────────────────────────
# `pnpm fetch` scarica le dipendenze del lockfile nello store senza i sorgenti:
# il layer si invalida SOLO quando cambiano lockfile/workspace (non ad ogni commit).
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

# ── 3) Sorgenti + install offline + build backend ──────────────────
COPY . .
RUN pnpm install --frozen-lockfile --prefer-offline \
 && pnpm run typecheck:libs \
 && pnpm --filter @workspace/api-server run build

ENV NODE_ENV=production
ENV PORT=3000
ENV PYTHONPATH=/app/.python_packages:/app/scripts

EXPOSE 3000
CMD ["node", "artifacts/api-server/dist/index.cjs"]
