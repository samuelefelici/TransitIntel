# ─── Database (PostgreSQL self-hosted su Coolify) ────────────
# Rete interna Coolify (app e DB nello stesso progetto): usa l'hostname del
# servizio DB, senza SSL:
DATABASE_URL=postgres://user:password@<servizio-db>:5432/dbname
# DB esposto pubblicamente con certificato self-signed: aggiungi PGSSL_NO_VERIFY=1
# (vedi sotto) oppure usa ?sslmode=no-verify nella stringa.

# Imposta a 1 se il Postgres usa un certificato self-signed (no verifica TLS).
PGSSL_NO_VERIFY=

# ─── API Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CRON Secret (genera con: openssl rand -hex 32) ─────────
CRON_SECRET=your-secret-here

# ─── Bigliettazione / integrazione Caronte + Validatore ─────
# Chiave Bearer che protegge le rotte /api/caronte/* (active-trip, taps, quote,
# persist-classification, mark-urban-hourly) usate da Caronte (AVM) e dal
# validatore NFC. Deve combaciare con EXPO_PUBLIC_CERBERO_API_KEY del validatore.
# ⚠️ Se lasciata VUOTA gli endpoint /api/caronte/* sono APERTI (solo un warning).
# Genera con: openssl rand -hex 32
CERBERO_API_KEY=
# Opzionale: forza un feed GTFS specifico (altrimenti si usa quello attivo/predefinito).
GTFS_FEED_ID=

# ─── TomTom Traffic API ─────────────────────────────────────
# https://developer.tomtom.com → registrati → copia API key
TOMTOM_API_KEY=

# ─── Google Places API (opzionale, per sync POI) ────────────
# https://console.cloud.google.com → API & Services → Places API
GOOGLE_PLACES_API_KEY=

# ─── OpenRouteService (isocrone pedonali, gratuito) ──────────
# https://openrouteservice.org/dev/#/signup → copia API key
OPENROUTE_API_KEY=

# ─── Mapbox (frontend) ──────────────────────────────────────
# https://account.mapbox.com → copia default public token
MAPBOX_TOKEN=

# ─── Bounding Box Provincia di Ancona ────────────────────────
PROVINCE_BBOX=12.7,43.2,13.65,43.95

# ─── Frontend URL (per CORS) ─────────────────────────────────
# In produzione sarà il dominio Coolify, es: https://transitintel.tuodominio.it
FRONTEND_URL=http://localhost:5173

# ─── JWT / Auth secret (dev only) ─────────────────────────────
# Usare un segreto robusto in produzione (es: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# ─── Logger / livello di log
# Esempi: debug, info, warn, error
LOG_LEVEL=info

# ─── Frontend Vite environment (pubblico)
# Alcune parti del frontend leggono VITE_MAPBOX_TOKEN
VITE_MAPBOX_TOKEN=

# ─── Optional: model override for AI provider (dev)
# COPILOT_MODEL permette sovrascrivere il modello usato dal provider AI
COPILOT_MODEL=
