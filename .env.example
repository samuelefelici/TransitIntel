# ─── Database (PostgreSQL self-hosted su Coolify) ────────────
# Rete interna Coolify (app e DB nello stesso progetto): usa l'hostname del
# servizio DB, senza SSL:
DATABASE_URL=postgres://user:password@<servizio-db>:5432/dbname
# DB esposto pubblicamente con certificato self-signed: aggiungi PGSSL_NO_VERIFY=1
# (vedi sotto) oppure usa ?sslmode=no-verify nella stringa.

# Imposta a 1 se il Postgres usa un certificato self-signed (no verifica TLS).
PGSSL_NO_VERIFY=

# ─── API Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CRON Secret (genera con: openssl rand -hex 32) ─────────
CRON_SECRET=your-secret-here

# ─── TomTom Traffic API ─────────────────────────────────────
# https://developer.tomtom.com → registrati → copia API key
TOMTOM_API_KEY=

# ─── Google Places API (opzionale, per sync POI) ────────────
# https://console.cloud.google.com → API & Services → Places API
GOOGLE_PLACES_API_KEY=

# ─── OpenRouteService (isocrone pedonali, gratuito) ──────────
# https://openrouteservice.org/dev/#/signup → copia API key
OPENROUTE_API_KEY=

# ─── Mapbox (frontend) ──────────────────────────────────────
# https://account.mapbox.com → copia default public token
MAPBOX_TOKEN=

# ─── Bounding Box Provincia di Ancona ────────────────────────
PROVINCE_BBOX=12.7,43.2,13.65,43.95

# ─── Frontend URL (per CORS) ─────────────────────────────────
# In produzione sarà il dominio Coolify, es: https://transitintel.tuodominio.it
FRONTEND_URL=http://localhost:5173

# ─── JWT / Auth secret ────────────────────────────────────────
# OBBLIGATORIO in produzione: se manca, l'API rifiuta l'avvio (i token
# sarebbero firmati con una costante pubblica → forgiabili). In sviluppo
# c'è un fallback. Genera un segreto robusto: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# ─── Chiave ingest Caronte (validatore / AVM) ─────────────────
# OBBLIGATORIA in produzione: senza, gli endpoint /api/caronte (scrittura
# bigliettazione/AVM/GTFS-RT) rispondono 503 fail-closed. In sviluppo aperti.
CERBERO_API_KEY=your-caronte-key-here

# ─── Logger / livello di log
# Esempi: debug, info, warn, error
LOG_LEVEL=info

# ─── Frontend Vite environment (pubblico)
# Alcune parti del frontend leggono VITE_MAPBOX_TOKEN
VITE_MAPBOX_TOKEN=

# ─── Optional: model override for AI provider (dev)
# COPILOT_MODEL permette sovrascrivere il modello usato dal provider AI
COPILOT_MODEL=

# ─── Argos (assistente AI dentro Planning Studio) ─────────────
# Argos è un servizio separato (FastAPI/RAG) usato SOLO dentro Planning Studio,
# al posto di Virgilio. Il backend lo raggiunge su ARGOS_URL e gli inoltra le
# domande via /api/ai/argos/chat, passando l'id del progetto aperto: Argos legge
# i dati di QUEL progetto (tabelle ps_*) più i libri di teoria del TPL.
# Vuoto = pannello Argos disattivato (mostra "non configurato"). Nessuna slash finale.
# Esempio: http://argos:8000  (rete Docker/Coolify)  oppure  https://argos.tuodominio.it
ARGOS_URL=
# Slug del client Argos (budget/multi-tenant lato Argos). Default: tpl-personale
ARGOS_CLIENT_SLUG=tpl-personale

# ─── AVM esterno via SIRI Vehicle Monitoring ──────────────────
# Collega un sistema AVM che espone SIRI-VM (SOAP) e alimenta lo schema
# `caronte`: posizioni dei mezzi, corse in servizio e transiti alle fermate.
# Da lì si accendono da sole Sala Operativa, Tempi di percorrenza (programmato
# vs osservato) e il feed pubblico GTFS-RT. Vuoto = connettore spento.
# Esempio: https://flashnetconerobus.miz.it/SIRIService/VMWS/VMService.svc
SIRI_VM_URL=
# Codice consumatore assegnato dal produttore (SIRI RequestorRef).
SIRI_REQUESTOR_REF=TransitIntel
# Credenziali Basic, se il produttore le richiede.
SIRI_USERNAME=
SIRI_PASSWORD=
# Dettaglio della risposta. "calls" è necessario per avere le fermate già
# transitate: senza, restano alimentate solo posizioni e corse attive, e
# puntualità/tempi di percorrenza NON ricevono dati.
SIRI_DETAIL_LEVEL=calls
# Ogni quanti secondi interrogare l'AVM (minimo 10; rispettare il
# ShortestPossibleCycle dichiarato dal produttore in GetCapabilities).
#
# ATTENZIONE: il transito alla fermata si riconosce dal CAMBIO di fermata fra
# due letture consecutive. Oltre 300 s il cambio non è più attribuibile a una
# fermata sola e non verrebbe registrato NESSUN transito — quindi puntualità e
# tempi di percorrenza resterebbero vuoti. Un valore superiore viene perciò
# riportato d'ufficio a 60 s, con un avviso nei log e in /api/siri/status.
SIRI_POLL_SECONDS=30
# Override dell'header SOAPAction e timeout, se il produttore devia dallo standard.
SIRI_SOAP_ACTION=
SIRI_TIMEOUT_MS=20000
